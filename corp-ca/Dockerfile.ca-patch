# Wraps an upstream base image and installs the corporate TLS-interception CA
# (Cummins Prisma) into every trust store the toolchains inside use.
#
# Built by ./build-patched-bases.ps1 and injected into the project builds via
# BuildKit named contexts (see commercial-sdv-stack/docker-compose.corp-ca.yaml),
# so no upstream Dockerfile needs to be modified.

ARG BASE
FROM ${BASE}

USER root

COPY corp-ca-bundle.crt /usr/local/share/ca-certificates/corp-ca-bundle.crt

# Debian/Ubuntu + Alpine style trust stores
RUN set -eux; \
    if ! command -v update-ca-certificates >/dev/null 2>&1 \
       && ! command -v update-ca-trust >/dev/null 2>&1 \
       && command -v apt-get >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends ca-certificates \
        && rm -rf /var/lib/apt/lists/*; \
    fi; \
    if command -v update-ca-certificates >/dev/null 2>&1; then \
        update-ca-certificates; \
    elif command -v update-ca-trust >/dev/null 2>&1; then \
        cp /usr/local/share/ca-certificates/corp-ca-bundle.crt /etc/pki/ca-trust/source/anchors/; \
        update-ca-trust extract; \
    else \
        mkdir -p /etc/ssl/certs; \
        cat /usr/local/share/ca-certificates/corp-ca-bundle.crt >> /etc/ssl/certs/ca-certificates.crt; \
    fi

# Java keystore (gradle / temurin images). keytool only reads the first cert of a
# PEM file, so split the bundle and import each certificate individually.
RUN set -eux; \
    if command -v keytool >/dev/null 2>&1; then \
        cd /tmp; \
        awk 'BEGIN{n=0} /BEGIN CERTIFICATE/{n++} n>0{print > ("corpca-" n ".pem")} /END CERTIFICATE/{}' \
            /usr/local/share/ca-certificates/corp-ca-bundle.crt; \
        for f in /tmp/corpca-*.pem; do \
            keytool -importcert -noprompt -trustcacerts \
                -alias "corp-$(basename "$f" .pem)" \
                -file "$f" \
                -keystore "${JAVA_HOME}/lib/security/cacerts" \
                -storepass changeit || true; \
        done; \
        rm -f /tmp/corpca-*.pem; \
    fi

# Toolchains that do NOT use the system trust store need to be pointed at it.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_DIR=/etc/ssl/certs \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CARGO_HTTP_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
